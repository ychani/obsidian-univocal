{
	"name": "obsidian-univocal",
	"version": "0.1.1",
	"description": "Read notes aloud with Univocal and highlight each word as it's spoken.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit",
		"test": "vitest run",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint src --max-warnings 0"
	},
	"keywords": [
		"obsidian",
		"univocal",
		"tts",
		"read-aloud"
	],
	"author": "NarNar Labs",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@types/node": "^26.6.5",
		"esbuild": "^0.28.2",
		"eslint": "^10.13.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"jsdom": "^30.1.3",
		"obsidian": "^1.14.4",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@11.20.0"
}
